---
import '../styles/global.css';
---

<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Atlas-SI — Workforce de IA</title>
    <meta
      name="description"
      content="Atlas-SI: equipas de agentes de IA organizadas por divisões — engenharia, design, marketing e mais."
    />
  </head>
  <body class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <!-- Placeholder de arranque: o design próprio da Atlas vem depois do mapeamento do openbot.run -->
    <main class="mx-auto flex max-w-3xl flex-col items-center justify-center px-6 py-32 text-center">
      <p class="text-sm uppercase tracking-widest text-neutral-400">Atlas-SI</p>
      <h1 class="mt-4 text-4xl font-bold sm:text-5xl">Site em construção</h1>
      <p class="mt-6 max-w-xl text-lg text-neutral-300">
        Estamos a readaptar a experiência do openbot.run para a Atlas-SI — com
        identidade e conteúdo próprios. Esta página é o scaffold de arranque.
      </p>
      <a
        href="mailto:contact@atlas-si.com"
        class="mt-10 rounded-full bg-white px-6 py-3 font-medium text-neutral-900 transition hover:bg-neutral-200"
      >
        Falar connosco
      </a>
    </main>
  </body>
</html>
