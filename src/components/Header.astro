---
// Header global com mega-panels (estrutura do site de referência, código e logo próprios)
const panels = {
  news: {
    label: 'News',
    items: [
      { t: 'Artigo de referência 1', d: 'Data de referência', href: '#', ref: true },
      { t: 'Artigo de referência 2', d: 'Data de referência', href: '#', ref: true },
      { t: 'Artigo de referência 3', d: 'Data de referência', href: '#', ref: true },
      { t: 'Artigo de referência 4', d: 'Data de referência', href: '#', ref: true },
    ],
    more: 'Todos os artigos',
  },
  guides: {
    label: 'Guias',
    items: [
      { t: 'Guia de referência 1', d: 'Data de referência', href: '#', ref: true },
      { t: 'Guia de referência 2', d: 'Data de referência', href: '#', ref: true },
      { t: 'Guia de referência 3', d: 'Data de referência', href: '#', ref: true },
      { t: 'Guia de referência 4', d: 'Data de referência', href: '#', ref: true },
    ],
    more: 'Todos os guias',
  },
  compare: {
    label: 'Comparar',
    items: [
      { t: 'Comparação de referência 1', d: 'Data de referência', href: '#', ref: true },
      { t: 'Comparação de referência 2', d: 'Data de referência', href: '#', ref: true },
      { t: 'Comparação de referência 3', d: 'Data de referência', href: '#', ref: true },
      { t: 'Comparação de referência 4', d: 'Data de referência', href: '#', ref: true },
    ],
    more: 'Todas as comparações',
  },
  plugins: {
    label: 'Plugins',
    items: [
      { t: 'Plugin A', d: 'Descrição de referência', href: '#', ref: true },
      { t: 'Plugin B', d: 'Descrição de referência', href: '#', ref: true },
      { t: 'Plugin C', d: 'Descrição de referência', href: '#', ref: true },
      { t: 'Plugin D', d: 'Descrição de referência', href: '#', ref: true },
    ],
    more: 'Ver plugins',
  },
} as const;
---

<header class="anim-header-in sticky top-0 z-50 border-b border-[var(--atlas-border-soft)] bg-[var(--atlas-bg)]/85 backdrop-blur">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-1 px-4 text-[13px]">
    <a href="/" class="mr-2 flex items-center gap-2 font-semibold" aria-label="Início">
      <span class="relative inline-flex h-6 w-6 items-center justify-center rounded-full bg-white/10">
        <span class="anim-block anim-blink text-[10px]">◧</span>
      </span>
      <span>Atlas<span class="text-[var(--atlas-text-muted)]">-SI</span></span>
    </a>

    {Object.entries(panels).map(([key, p]) => (
      <div class="group relative">
        <button class="rounded-full px-3 py-1.5 text-[var(--atlas-text-muted)] transition-colors duration-150 hover:bg-[var(--atlas-hover)] hover:text-white">
          {p.label}
        </button>
        <div class="anim-panel-in invisible absolute left-0 top-full mt-1 w-72 rounded-2xl border border-[var(--atlas-border-soft)] bg-[var(--atlas-bg-raised)] p-2 opacity-0 shadow-2xl transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          {p.items.map((it) => (
            <a href={it.href} class="block rounded-xl px-3 py-2 transition-colors hover:bg-[var(--atlas-hover)]">
              <span class="block font-medium text-white">{it.t} <span class="text-[var(--atlas-text-placeholder)]">[REF]</span></span>
              <span class="block text-xs text-[var(--atlas-text-muted)]">{it.d}</span>
            </a>
          ))}
          <a href={p.more} class="mt-1 block px-3 py-2 text-xs text-[var(--atlas-text-muted)] hover:text-white">{p.more} →</a>
        </div>
      </div>
    ))}

    <a href="#" class="rounded-full px-3 py-1.5 text-[var(--atlas-text-muted)] transition-colors hover:bg-[var(--atlas-hover)] hover:text-white">Recursos</a>

    <div class="ml-auto flex items-center gap-1">
      <a href="#" class="rounded-full px-3 py-1.5 text-[var(--atlas-text-muted)] transition-colors hover:bg-[var(--atlas-hover)] hover:text-white">Para equipas</a>
      <a href="#" class="rounded-full px-3 py-1.5 text-[var(--atlas-text-muted)] transition-colors hover:bg-[var(--atlas-hover)] hover:text-white">Preços</a>
      <a href="#download" class="ml-1 rounded-full bg-white px-4 py-1.5 font-medium text-black transition-colors hover:bg-neutral-200">Download</a>
    </div>
  </nav>
</header>
